{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brain4u.local/contracts/learning-record.schema.json",
  "title": "Brain4U learning record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "date", "author", "privacy", "sources", "content"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "format": "date" },
    "author": { "type": "string", "minLength": 1 },
    "privacy": { "enum": ["shared", "restricted"] },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "content": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}

{
  "display_information": {
    "name": "Brain4U",
    "description": "Private company brain, powered by Hermes",
    "background_color": "#1a1a2e"
  },
  "features": {
    "bot_user": {
      "display_name": "Brain4U",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/hermes",
        "description": "Talk to Brain4U or run a subcommand",
        "usage_hint": "[subcommand] [args]",
        "should_escape": false,
        "url": "https://brain4u.local/slack/commands"
      },
      {
        "command": "/new",
        "description": "Start a new conversation",
        "usage_hint": "[name]",
        "should_escape": false,
        "url": "https://brain4u.local/slack/commands"
      },
      {
        "command": "/stop",
        "description": "Stop running background processes",
        "should_escape": false,
        "url": "https://brain4u.local/slack/commands"
      },
      {
        "command": "/approve",
        "description": "Approve a pending protected action",
        "usage_hint": "[session|always]",
        "should_escape": false,
        "url": "https://brain4u.local/slack/commands"
      },
      {
        "command": "/deny",
        "description": "Deny a pending protected action",
        "should_escape": false,
        "url": "https://brain4u.local/slack/commands"
      },
      {
        "command": "/help",
        "description": "Show available commands",
        "should_escape": false,
        "url": "https://brain4u.local/slack/commands"
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "chat:write",
        "commands",
        "files:read",
        "groups:history",
        "im:history",
        "im:read",
        "im:write",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.channels",
        "message.groups",
        "message.im"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
